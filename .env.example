PORT=4000
NODE_ENV=development

# Step 3+ — MySQL connection string (Prisma format)
DATABASE_URL="mysql://YOUR_USERNAME:speakml_pass@localhost:PORT_NUMBER/speakml"

# Internal Python ML service base URL (not called until a later step)
ML_SERVICE_URL=http://localhost:8000

STORAGE_TYPE=local
STORAGE_PATH=./storage

# 10 MB, in bytes
MAX_FILE_SIZE=10485760
